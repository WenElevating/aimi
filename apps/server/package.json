{
  "name": "@aimi/server",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "aimi-server": "dist/bin/aimi-server.js"
  },
  "scripts": {
    "dev": "tsx watch src/bin/aimi-server.ts start",
    "test": "vitest run --no-file-parallelism",
    "build": "tsc -p tsconfig.build.json",
    "test:unit": "vitest run src --no-file-parallelism",
    "test:e2e": "vitest run __tests__ --no-file-parallelism",
    "test:coverage": "vitest run --coverage --no-file-parallelism"
  },
  "dependencies": {
    "@aimi/protocol": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "adbkit-apkreader": "^3.2.0",
    "better-sqlite3": "^12.0.0",
    "js-yaml": "^4.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "8.7.1",
    "@stryker-mutator/vitest-runner": "8.7.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
